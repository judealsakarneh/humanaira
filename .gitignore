# ─── Secrets ─────────────────────────────────────────────────────────────────
# Everything below stays out of git. A committed .env is how this repo leaked a
# live Stripe key once already; the patterns are deliberately broad so a new
# variant (.env.staging, .env.local.bak) cannot slip through the same gap.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/

# ─── Build output ────────────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ─── Deploy / tooling state ──────────────────────────────────────────────────
.vercel
.turbo
.cache/

# ─── Test & coverage ─────────────────────────────────────────────────────────
coverage/

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ─── Local uploads ───────────────────────────────────────────────────────────
public/uploads/
client/public/uploads/
