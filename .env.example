# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.example .env.local
#
# Every value here is a placeholder. Real keys live in your local .env.local and
# in the Vercel project's Environment Variables, nowhere else.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key are safe in the browser; the service role key is NOT.
# It bypasses every Row Level Security policy, so it must only ever be read from
# server-side code (route handlers, server actions) and never prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use sk_test_/pk_test_ keys in development. The publishable key is the only one
# that belongs in the browser.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Platform commission on each order, as a percentage.
PLATFORM_FEE_PERCENT=10

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=hello@example.com
NEWSLETTER_BCC_EMAIL=you@example.com

# ─── Realtime chat (Stream) ──────────────────────────────────────────────────
NEXT_PUBLIC_STREAM_KEY=your-stream-key
STREAM_SECRET=your-stream-secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
